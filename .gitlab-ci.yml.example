stages: [security]

variables:
  GIT_STRATEGY: fetch

trivy-scan:
  stage: security
  image: alpine:3.20
  before_script:
    - apk add --no-cache bash curl jq docker-cli
    # ставим trivy (статический бинарь)
    - TRIVY_VERSION=$(curl -s https://api.github.com/repos/aquasecurity/trivy/releases/latest | jq -r .tag_name)
    - curl -sL "https://github.com/aquasecurity/trivy/releases/download/${TRIVY_VERSION}/trivy_${TRIVY_VERSION#v}_Linux-64bit.tar.gz" -o trivy.tar.gz
    - tar xzf trivy.tar.gz && mv trivy /usr/local/bin/
  script:
    - chmod +x scan_trivy.sh
    - ./scan_trivy.sh images.txt reports
  artifacts:
    when: always
    expire_in: 14 days
    paths:
      - reports/
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
    - if: $CI_COMMIT_BRANCH == "main"

schedules:
  # В UI GitLab создайте Schedule (ежедневно в 02:00) на этот пайплайн.
